# Demo mode needs no environment variables at all.
# These are only required to run "Live AI" mode outside Vercel.
# Vercel deployments authenticate to AI Gateway automatically via OIDC (VERCEL_OIDC_TOKEN).

# Vercel AI Gateway key - https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: swap the model behind all three agents without code changes.
# Any AI Gateway model id, e.g. openai/gpt-5.6-sol, anthropic/claude-opus-5
RESEARCH_MODEL_ID=

# Optional: point at a different OpenAI-compatible endpoint (defaults to AI Gateway).
AI_GATEWAY_BASE_URL=

# Optional: where `npm run dev` proxies /api/* in development (defaults to http://127.0.0.1:8000).
API_DEV_URL=

# Optional: canonical URL used for metadata and Open Graph tags.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
